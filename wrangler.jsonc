{
  // Cloudflare Worker: serves the static site in ./public plus the /api/sync endpoint (src/worker.js)
  "name": "bms235-html-4",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
  // Sync storage: add the Workers KV namespace here once it exists, e.g.
  // "kv_namespaces": [{ "binding": "SYNC", "id": "<namespace id>" }]
}
