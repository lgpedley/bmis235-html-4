{
  // Cloudflare Worker: serves the static site in ./public plus the /api/sync endpoint (src/worker.js)
  "name": "bms235-html-4",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Workers KV namespace "gentle-plate-sync": stores each sync code's data
  "kv_namespaces": [
    { "binding": "SYNC", "id": "e927f0295f3b47c0a59167769ef4f187" }
  ]
}
